# Copy to .env and adjust as needed. All of these are optional - sane
# defaults are used if unset (see SETUP.md).

# SQLite is the default; set this to a Postgres DSN to use TimescaleDB
# instead (see docker-compose.yml).
# DATABASE_URL=postgresql+asyncpg://netmap:netmap@localhost:5432/netmap

# Comma-separated list of origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173

# Optional: email delivery for critical alerts. Alerts still show in-app
# either way if these are left unset.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=
